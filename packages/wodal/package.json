{
  "name": "@mindcraft-lang/wodal",
  "version": "0.2.1",
  "description": "WODAL: A CODAL-inspired web device runtime for the Mindcraft bytecode VM.",
  "license": "MIT",
  "type": "module",
  "author": "humanapp",
  "repository": {
    "type": "git",
    "url": "https://github.com/humanapp/mindcraft-mcu.git",
    "directory": "packages/wodal"
  },
  "bugs": {
    "url": "https://github.com/humanapp/mindcraft-mcu/issues"
  },
  "homepage": "https://github.com/humanapp/mindcraft-mcu/tree/main/packages/wodal#readme",
  "keywords": [
    "mindcraft",
    "microbit",
    "codal",
    "education",
    "stem",
    "coding"
  ],
  "files": [
    "dist",
    "ambient",
    "lib",
    "targets",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "wodal": "dist/cli/wodal.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./targets/microbit-v2": {
      "types": "./dist/targets/microbit-v2/index.d.ts",
      "browser": "./dist/targets/microbit-v2/index.js",
      "import": "./dist/targets/microbit-v2/index.js"
    },
    "./ambient/mindcraft.wodal.d.ts": {
      "default": "./ambient/mindcraft.wodal.d.ts"
    },
    "./ambient/mindcraft.microbit-v2.d.ts": {
      "default": "./ambient/mindcraft.microbit-v2.d.ts"
    },
    "./lib/mindcraft.json": {
      "default": "./lib/mindcraft.json"
    },
    "./lib/index.ts": {
      "default": "./lib/index.ts"
    },
    "./targets/microbit-v2/lib/mindcraft.json": {
      "default": "./targets/microbit-v2/lib/mindcraft.json"
    },
    "./targets/microbit-v2/lib/index.ts": {
      "default": "./targets/microbit-v2/lib/index.ts"
    },
    "./targets/microbit-v2/lib/image.ts": {
      "default": "./targets/microbit-v2/lib/image.ts"
    }
  },
  "scripts": {
    "build:deps": "npm run build:node --prefix ../../external/mindcraft-lang/packages/core && npm run build:esm --prefix ../../external/mindcraft-lang/packages/core && npm run build:prod --prefix ../../external/mindcraft-lang/packages/ts-compiler && npm run build:prod --prefix ../../external/mindcraft-lang/packages/service-api",
    "prebuild": "npm run build:deps",
    "build": "tsc -p tsconfig.json && npm run build:cli",
    "build:cli": "esbuild src/cli/wodal.ts --bundle --platform=node --format=esm --outfile=dist/cli/wodal.js",
    "build:prod": "tsc --build tsconfig.prod.json && npm run build:cli",
    "clean": "tsc --build tsconfig.json --clean",
    "pregenerate:ambient": "npm run build:deps",
    "generate:ambient": "tsx --tsconfig scripts/tsconfig.json scripts/generate-ambient.ts",
    "lint:only": "biome lint ./src",
    "check:only": "biome check ./src",
    "format:only": "biome format ./src",
    "lint": "biome lint ./src --write",
    "check": "biome check ./src --write",
    "pretypecheck": "npm run build:deps",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.spec.json && tsc --noEmit -p ambient/tsconfig.json && tsc --noEmit -p scripts/tsconfig.json && tsc --noEmit -p lib/tsconfig.json && tsc --noEmit -p targets/microbit-v2/lib/tsconfig.json",
    "format": "biome format ./src --write",
    "pretest": "npm run build:deps && npm run build:prod",
    "test": "tsx --tsconfig tsconfig.spec.json --test $(find src -name '*.spec.ts')",
    "release:patch": "node ../../external/mindcraft-lang/scripts/release.js patch",
    "release:minor": "node ../../external/mindcraft-lang/scripts/release.js minor",
    "release:major": "node ../../external/mindcraft-lang/scripts/release.js major"
  },
  "dependencies": {
    "@mindcraft-lang/core": "file:../../external/mindcraft-lang/packages/core",
    "@mindcraft-lang/service-api": "file:../../external/mindcraft-lang/packages/service-api",
    "typescript": "~5.9.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.15",
    "@mindcraft-lang/ts-compiler": "file:../../external/mindcraft-lang/packages/ts-compiler",
    "esbuild": "^0.27.7",
    "tsx": "^4.21.0"
  }
}
