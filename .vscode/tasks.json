{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "cpp: configure (debug)",
      "type": "shell",
      "command": "cmake --preset debug",
      "options": { "cwd": "${workspaceFolder}/cpp" },
      "problemMatcher": []
    },
    {
      "label": "cpp: build (debug)",
      "type": "shell",
      "command": "cmake --preset debug && cmake --build --preset debug",
      "options": { "cwd": "${workspaceFolder}/cpp" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "cpp: test (debug)",
      "type": "shell",
      "command": "ctest --preset debug",
      "options": { "cwd": "${workspaceFolder}/cpp" },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "cpp: check",
      "type": "shell",
      "command": "./check.sh",
      "options": { "cwd": "${workspaceFolder}/cpp" },
      "problemMatcher": []
    },
    {
      "label": "wendoo-ext: build",
      "type": "shell",
      "command": "npm run build",
      "options": {
        "cwd": "${workspaceFolder}/external/wendoo-lang/apps/vscode-extension"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "wendoo-ext: dev",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/external/wendoo-lang/apps/vscode-extension"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^never$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "build finished"
        }
      },
      "group": "build"
    },
    {
      "label": "vscode-bridge: build",
      "type": "shell",
      "command": "npm run build",
      "options": {
        "cwd": "${workspaceFolder}/external/wendoo-lang/apps/vscode-bridge"
      },
      "group": "build",
      "problemMatcher": []
    }
  ]
}
