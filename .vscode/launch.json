{
  "version": "0.2.0",
  "compounds": [
    {
      "name": "vscode-extension: web",
      "configurations": ["[ext] server", "[ext] Chrome"]
    }
  ],
  "configurations": [
    {
      "name": "cpp tests (CodeLLDB)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/cpp/build/debug/test/wendoo-tests",
      "args": [],
      "cwd": "${workspaceFolder}/cpp",
      "preLaunchTask": "cpp: build (debug)"
    },
    {
      "name": "cpp tests (cpptools)",
      "type": "cppdbg",
      "request": "launch",
      "MIMode": "lldb",
      "program": "${workspaceFolder}/cpp/build/debug/test/wendoo-tests",
      "args": [],
      "cwd": "${workspaceFolder}/cpp",
      "preLaunchTask": "cpp: build (debug)"
    },
    {
      "name": "[ext] server",
      "presentation": { "hidden": true },
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/external/wendoo-lang/apps/vscode-extension/node_modules/@vscode/test-web/out/server/index.js",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/external/wendoo-lang/apps/vscode-extension",
        "--browser",
        "none",
        "--port",
        "3100",
        "--coi"
      ],
      "outFiles": ["${workspaceFolder}/external/wendoo-lang/apps/vscode-extension/dist/**/*.js"],
      "preLaunchTask": "wendoo-ext: dev",
      "console": "integratedTerminal"
    },
    {
      "name": "[ext] Chrome",
      "presentation": { "hidden": true },
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3100",
      "webRoot": "${workspaceFolder}/external/wendoo-lang/apps/vscode-extension",
      "sourceMaps": true
    },
    {
      "type": "node",
      "request": "launch",
      "name": "vscode-bridge: dev",
      "runtimeExecutable": "${workspaceFolder}/external/wendoo-lang/apps/vscode-bridge/node_modules/.bin/tsx",
      "runtimeArgs": ["--conditions=development"],
      "args": ["src/index.ts"],
      "cwd": "${workspaceFolder}/external/wendoo-lang/apps/vscode-bridge",
      "envFile": "${workspaceFolder}/external/wendoo-lang/apps/vscode-bridge/.env",
      "preLaunchTask": "vscode-bridge: build",
      "console": "integratedTerminal",
      "sourceMaps": true,
      "resolveSourceMapLocations": ["${workspaceFolder}/**", "!**/node_modules/**"]
    }
  ]
}
