{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noFallthroughCasesInSwitch": true,

    /* Path mapping */
    "paths": {
      "@/*": ["./src/*"],
      "@wendoo/assistant-panel": ["../../external/wendoo-lang/packages/assistant-panel/src/index.ts"],
      "@wendoo/assistant-panel/*": ["../../external/wendoo-lang/packages/assistant-panel/src/*"],
      "@wendoo/ui": ["../../external/wendoo-lang/packages/ui/src/index.ts"],
      "@wendoo/ui/*": ["../../external/wendoo-lang/packages/ui/src/*"],
      "@wendoo/docs": ["../../external/wendoo-lang/packages/docs/src/index.ts"],
      "@wendoo/docs/*": ["../../external/wendoo-lang/packages/docs/src/*"]
    }
  },
  "include": ["src"],
  "exclude": ["src/**/*.spec.ts"]
}
