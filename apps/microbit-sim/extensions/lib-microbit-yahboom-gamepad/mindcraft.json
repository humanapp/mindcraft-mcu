{
  "name": "Yahboom Gamepad",
  "version": "0.1.2",
  "identity": "mindcraft-lang/lib-microbit-yahboom-gamepad",
  "description": "Yahboom GHBit gamepad driver for the micro:bit (v2): the thumb-stick direction and continuous position sensors, the colored-button sensor, the received-packet decoder, and the position-to-packet radio encoding.",
  "extensions": {
    "mindcraft-lang/lib-codal-position": "embedded:mindcraft-lang/lib-codal-position"
  },
  "files": [
    "protocol.ts",
    "stick-read.ts",
    "stick.ts",
    "button.ts",
    "stick-position.ts",
    "decoded-stick-position.ts",
    "position-to-buffer.ts",
    "docs/stick.md",
    "docs/button.md",
    "docs/stick-position.md",
    "docs/decoded-stick-position.md",
    "icons/stick.svg",
    "icons/button.svg",
    "icons/stick-position.svg",
    "icons/decoded-stick-position.svg"
  ],
  "targets": {
    "mindcraft-lang/trg-microbit-v2": {
      "packageVersion": "^0.2.0"
    }
  }
}