  "extensions": {
    "mindcraft-lang/lib-codal-position": "embedded:mindcraft-lang/lib-codal-position"
  },
  "files": [
    "movement.ts",
    "drive.ts",
    "turn.ts",
    "pivot.ts",
    "stop.ts",
    "steer.ts",
    "line-sensor.ts",
    "line-left.ts",
    "line-right.ts",
    "docs/drive.md",
    "docs/turn.md",
    "docs/pivot.md",
    "docs/stop.md",
    "docs/steer.md",
    "docs/line-left.md",
    "docs/line-right.md"
  ],
  "targets": {
    "mindcraft-lang/microbit-v2": {
      "packageVersion": "^0.2.0"
    }
  }
}