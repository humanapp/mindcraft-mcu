{
  "compilerOptions": {
    "noCheck": true,
    "noEmit": true,
    "noLib": true,
    "strict": false,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2020",
    "skipLibCheck": true,
    "skipDefaultLibCheck": true
  },
  "include": ["**/*.ts"],
  "exclude": ["index.ts"]
}
