{
  "name": "@mindcraft-lang/microbit-sim",
  "description": "Microbit Simulator for Mindcraft",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "author": "humanapp",
  "license": "MIT",
  "scripts": {
    "dev": "vite --config vite/config.dev.mjs --force",
    "build": "vite build --config vite/config.prod.mjs",
    "build:deps": "node ../../scripts/build-packages.js .",
    "package": "vite build --config vite/config.prod.mjs && node scripts/assemble-target-package.mjs",
    "release-target": "node scripts/release-target.mjs",
    "clean": "rm -rf dist && rm -rf node_modules/.vite",
    "vendor:firmware": "node scripts/vendor-firmware.mjs",
    "generate:docs": "node scripts/build-docs.mjs",
    "check:only": "biome check ./src",
    "check": "biome check ./src --write",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.spec.json",
    "test": "tsx --tsconfig tsconfig.spec.json --test $(find src -name '*.spec.ts')",
    "release:patch": "node ../../scripts/release.js patch --skip-deps",
    "release:minor": "node ../../scripts/release.js minor --skip-deps",
    "release:major": "node ../../scripts/release.js major --skip-deps"
  },
  "dependencies": {
    "@microbit/microbit-connection": "^0.1.0",
    "@mindcraft-lang/app-host": "file:../../external/mindcraft-lang/packages/app-host",
    "@mindcraft-lang/bridge-app": "file:../../external/mindcraft-lang/packages/bridge-app",
    "@mindcraft-lang/core": "file:../../external/mindcraft-lang/packages/core",
    "@mindcraft-lang/docs": "file:../../external/mindcraft-lang/packages/docs",
    "@mindcraft-lang/ts-compiler": "file:../../external/mindcraft-lang/packages/ts-compiler",
    "@mindcraft-lang/ui": "file:../../external/mindcraft-lang/packages/ui",
    "@mindcraft-lang/wodal": "file:../../packages/wodal",
    "lucide-react": "^0.561.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.15",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^25.0.2",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/w3c-web-usb": "^1.0.10",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.2.5",
    "mindcraft-cli": "file:../../external/mindcraft-lang/packages/cli",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "terser": "^5.28.1",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.26.1",
    "vite": "^6.3.1"
  }
}
